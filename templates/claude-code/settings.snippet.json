{
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$BODHI_ROOT/scripts/harness-session-lifecycle.sh\" claude-code",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "BODHI_ROOT=\"$BODHI_ROOT\" bash \"$BODHI_ROOT/templates/claude-code/hooks/postcompact-recall.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$BODHI_ROOT/templates/claude-code/hooks/precompact-checkpoint.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
