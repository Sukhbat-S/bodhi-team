# BODHI runtime template — copy to .env and fill in only the supported keys.
# The active harness (Codex or Claude Code) owns reasoning and execution outside
# the BODHI server. This file configures the durable substrate, local MCP adapter,
# deterministic maintenance, and explicitly supported operator commands.

# --- Server and substrate runtime ---
# PostgreSQL with pgvector; never reuse another owner's database URL.
DATABASE_URL=postgresql://your-local-user@localhost:5432/bodhi
# Voyage AI embeddings for semantic memory search.
VOYAGE_API_KEY=
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
TIMEZONE=Asia/Ulaanbaatar
BODHI_HOME=
# Explicit continuity backup roots; otherwise use BODHI_HOME/backups or the legacy home backup directory.
BODHI_BACKUP_ROOT=
BODHI_BACKUP_OFFSITE_ROOT=
BODHI_INSTANCE=
BODHI_PROFILE=
BODHI_OWNER_NAME=User
BODHI_OWNER_ALIASES=
BODHI_ASSISTANT_NAME=BODHI
BODHI_PROJECT=
BODHI_PROJECT_DIR=
BODHI_REPO_ROOT=
BODHI_ALLOWED_HOST=
CORS_ORIGINS=
PUBLIC_URL=

# Mutating API auth is optional for the default loopback-only single-user mode.
# When enabled, use a strong value (for example: openssl rand -hex 32).
BODHI_API_AUTH=
BODHI_API_TOKEN=

# --- MCP adapter ---
# Installed plugins may point at a private env file and local API endpoint.
BODHI_ENV_FILE=
BODHI_URL=http://localhost:4000
BODHI_PORT=4000

# --- Retained scheduler and maintenance ---
# The scheduler contract contains eight deterministic jobs. Opt-in evaluation
# jobs default off; the other gates may be set false to suppress a job.
RETRIEVAL_EVAL_ENABLED=
COHERENCE_CHECK_ENABLED=
SYSTEM_EVENTS_RETENTION_ENABLED=
FORGETTING_TIER_ENABLED=
PARKING_MAINTENANCE_ENABLED=
LIBRARY_RETRIEVAL_EVAL_ENABLED=
MAINTENANCE_LIVENESS_ENABLED=
CHECKPOINT_MAINTENANCE_ENABLED=
SCHEDULER_CATCHUP_ENABLED=
STALENESS_WATCH_ENABLED=

# --- Explicit operator-script inputs ---
BODHI_START_TIMEOUT_SECONDS=60
BODHI_API_URL=http://localhost:4000
BODHI_EXPORT_PATH=
BODHI_RELEASE_MANIFEST=
BODHI_MIGRATION_BACKUP_PATH=
BODHI_MIGRATION_BASELINE_SHA256=
CORPUS_VERIFY_DATABASE_URL=
FOUNDATION_VERIFY_DATABASE_URL=
